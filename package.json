{
  "name": "telnyx-chatwoot-sms-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ai": "vitest run tests/unit/ai tests/contract/ai-openai-adapter.test.ts tests/contract/chatwoot-ai-history.test.ts tests/contract/marker-aware-webhook.test.ts tests/integration/ai --exclude tests/integration/ai/live-openai.test.ts",
    "test:live-ai": "vitest run tests/integration/ai/live-openai.test.ts",
    "test:local-live-ai-chatwoot": "vitest run tests/integration/ai/local-live-chatwoot.test.ts"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "^8.13.1",
    "pino": "9.14.0",
    "redis": "^4.7.0",
    "yaml": "2.8.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
