{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jama.local/contracts/telnyx-chatwoot-readiness-v1.schema.json",
  "title": "JAMA Telnyx-Chatwoot Runtime Readiness Artifact",
  "description": "Authoritative, expiring, secret-free live-audit facts. Runtime must additionally enforce the seven-day maximum lifetime and compare keyed fingerprints with the current environment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "expires_at",
    "status",
    "chatwoot",
    "telnyx",
    "ingress",
    "fingerprints",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "unresolved"]
    },
    "chatwoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_url",
        "version",
        "version_probe",
        "account_id",
        "inbox_id",
        "inbox_identifier",
        "hmac_supported",
        "signing_contract"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "version_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path", "json_pointer"],
          "properties": {
            "method": {
              "const": "GET"
            },
            "path": {
              "type": "string",
              "pattern": "^/[^?#]*$"
            },
            "json_pointer": {
              "type": "string",
              "pattern": "^(|/(?:[^~/]|~[01])*)+$"
            }
          }
        },
        "account_id": {
          "type": "integer",
          "minimum": 1
        },
        "inbox_id": {
          "type": "integer",
          "minimum": 1
        },
        "inbox_identifier": {
          "type": "string",
          "minLength": 1
        },
        "hmac_supported": {
          "type": "boolean"
        },
        "signing_contract": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "signature_header",
                "timestamp_header",
                "delivery_id_header",
                "algorithm",
                "digest_encoding",
                "canonical_bytes",
                "freshness_seconds"
              ],
              "properties": {
                "signature_header": {
                  "type": "string",
                  "minLength": 1
                },
                "timestamp_header": {
                  "type": ["string", "null"]
                },
                "delivery_id_header": {
                  "type": ["string", "null"]
                },
                "algorithm": {
                  "type": "string",
                  "minLength": 1
                },
                "digest_encoding": {
                  "type": "string",
                  "minLength": 1
                },
                "canonical_bytes": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Non-secret textual description of the exact observed signed-byte construction."
                },
                "freshness_seconds": {
                  "type": ["integer", "null"],
                  "minimum": 0
                }
              }
            }
          ]
        }
      }
    },
    "telnyx": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sender_profile_binding_verified",
        "ed25519_verified",
        "event_semantics_verified",
        "send_restrictions_verified"
      ],
      "properties": {
        "sender_profile_binding_verified": {
          "type": "boolean"
        },
        "ed25519_verified": {
          "type": "boolean"
        },
        "event_semantics_verified": {
          "type": "boolean"
        },
        "send_restrictions_verified": {
          "type": "boolean"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bridge_only_verified", "chatwoot_private_verified"],
      "properties": {
        "bridge_only_verified": {
          "type": "boolean"
        },
        "chatwoot_private_verified": {
          "type": "boolean"
        }
      }
    },
    "fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chatwoot",
        "telnyx_sender",
        "telnyx_messaging_profile",
        "ingress"
      ],
      "properties": {
        "chatwoot": {
          "$ref": "#/$defs/fingerprint"
        },
        "telnyx_sender": {
          "$ref": "#/$defs/fingerprint"
        },
        "telnyx_messaging_profile": {
          "$ref": "#/$defs/fingerprint"
        },
        "ingress": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "description": "A non-secret repository-relative path or HTTPS reference."
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "chatwoot": {
            "properties": {
              "hmac_supported": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "chatwoot": {
            "properties": {
              "signing_contract": {
                "type": "object"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "chatwoot": {
            "properties": {
              "signing_contract": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "chatwoot": {
            "properties": {
              "hmac_supported": {
                "const": true
              }
            }
          },
          "telnyx": {
            "properties": {
              "sender_profile_binding_verified": {
                "const": true
              },
              "ed25519_verified": {
                "const": true
              },
              "event_semantics_verified": {
                "const": true
              },
              "send_restrictions_verified": {
                "const": true
              }
            }
          },
          "ingress": {
            "properties": {
              "bridge_only_verified": {
                "const": true
              },
              "chatwoot_private_verified": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
